---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WordCounterTool } from '@/pages/_WordCounterTool';
import { getContent } from '@/lib/i18n';

const lang = 'fr';
const content = getContent(lang);
const faqItems = content.freeTools.wordCounter.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.freeTools.wordCounter.meta.title}
  metaDescription={content.freeTools.wordCounter.meta.description}
  currentPath="/fr/outils-gratuits/compteur-de-mots"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Accueil', url: 'https://www.askingfranklin.com/fr' },
    { name: 'Outils Gratuits' },
    { name: 'Compteur de Mots' },
  ]}
>
  <WordCounterTool lang={lang} content={content} client:load />
</BaseLayout>
