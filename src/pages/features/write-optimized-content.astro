---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FeatureOptimizedContent } from '@/pages/_FeatureOptimizedContent';
import { getContent } from '@/lib/i18n';

const lang = 'en';
const content = getContent(lang);
const faqItems = content.features.optimizedContent.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.features.optimizedContent.meta.title}
  metaDescription={content.features.optimizedContent.meta.description}
  currentPath="/features/write-optimized-content"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.askingfranklin.com/' },
    { name: 'Features', url: 'https://www.askingfranklin.com/' },
    { name: 'Write Optimized Content' },
  ]}
>
  <FeatureOptimizedContent lang={lang} content={content} client:load />
</BaseLayout>
