---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FeatureAutopilot } from '@/pages/_FeatureAutopilot';
import { getContent } from '@/lib/i18n';

const lang = 'en';
const content = getContent(lang);
const faqItems = content.features.autopilot.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.features.autopilot.meta.title}
  metaDescription={content.features.autopilot.meta.description}
  currentPath="/features/autopilot"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.askingfranklin.com/' },
    { name: 'Features', url: 'https://www.askingfranklin.com/' },
    { name: 'Autopilot' },
  ]}
>
  <FeatureAutopilot lang={lang} content={content} client:load />
</BaseLayout>
