---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FeatureDataInsights } from '@/pages/_FeatureDataInsights';
import { getContent } from '@/lib/i18n';

const lang = 'en';
const content = getContent(lang);
const faqItems = content.features.dataInsights.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.features.dataInsights.meta.title}
  metaDescription={content.features.dataInsights.meta.description}
  currentPath="/features/data-insights"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.askingfranklin.com/' },
    { name: 'Features', url: 'https://www.askingfranklin.com/' },
    { name: 'Data & Insights' },
  ]}
>
  <FeatureDataInsights lang={lang} content={content} client:load />
</BaseLayout>
