---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SchemaGeneratorTool } from '@/pages/_SchemaGeneratorTool';
import { getContent } from '@/lib/i18n';

const lang = 'en';
const content = getContent(lang);
const faqItems = content.freeTools.schemaGenerator.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.freeTools.schemaGenerator.meta.title}
  metaDescription={content.freeTools.schemaGenerator.meta.description}
  currentPath="/free-tools/schema-generator"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.askingfranklin.com/' },
    { name: 'Free Tools' },
    { name: 'Schema Generator' },
  ]}
>
  <SchemaGeneratorTool lang={lang} content={content} client:load />
</BaseLayout>
