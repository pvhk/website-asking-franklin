---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SerpPreviewTool } from '@/pages/_SerpPreviewTool';
import { getContent } from '@/lib/i18n';

const lang = 'en';
const content = getContent(lang);
const faqItems = content.freeTools.serpPreview.faq?.items || [];
---

<BaseLayout
  lang={lang}
  metaTitle={content.freeTools.serpPreview.meta.title}
  metaDescription={content.freeTools.serpPreview.meta.description}
  currentPath="/free-tools/serp-preview"
  faqData={faqItems}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.askingfranklin.com/' },
    { name: 'Free Tools' },
    { name: 'SERP Preview' },
  ]}
>
  <SerpPreviewTool lang={lang} content={content} client:load />
</BaseLayout>
